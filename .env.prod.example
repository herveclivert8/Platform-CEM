# Variables de docker-compose.prod.yml — copiez ce fichier en .env.prod (jamais commité)

# Obligatoires
POSTGRES_PASSWORD=remplacez-moi
# Générez-la avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacez-moi

# Port HTTP publié par le site
HTTP_PORT=80

# Paiement par carte : "disabled" tant qu'aucun vrai prestataire n'est branché
# (la simulation est refusée en production)
CARD_PAYMENT_PROVIDER=disabled

# Emails (optionnel) — voir le README
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@cem.mg
FROM_NAME=Club Excellence Madagascar
