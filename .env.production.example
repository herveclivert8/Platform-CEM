# ========================================
# CEM Platform - variables de production (VPS) pour docker-compose.prod.yml
#
#   cp .env.production.example .env.production && chmod 600 .env.production
#   Ne jamais commiter .env.production une fois rempli (déjà ignoré par git).
# ========================================

# --- Docker ---
# Port local du site (127.0.0.1 uniquement), relayé en HTTPS par le nginx de l'hôte
HTTP_PORT=8090
# Sous-réseau du réseau Docker "web" (proxys de confiance) : à changer en cas de conflit
WEB_SUBNET=172.30.250.0/24
RESTART_POLICY=always

# --- PostgreSQL ---
POSTGRES_USER=cem
POSTGRES_DB=cem
# SECRET - générer avec : openssl rand -hex 32
# (hexadécimal : inséré tel quel dans l'URL de connexion)
POSTGRES_PASSWORD=

# --- Application ---
# SECRET - générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# (le changer déconnecte tous les utilisateurs)
SECRET_KEY=
# Adresse publique du site (liens des emails)
FRONTEND_URL=https://cem.community

# Aucun vrai prestataire de paiement par carte branché pour l'instant
CARD_PAYMENT_PROVIDER=disabled
# "live" pour publier réellement sur les réseaux (jetons Meta / LinkedIn requis, voir backend/.env.example)
SOCIAL_PUBLISHING=disabled

# --- Emails (sans SMTP_USER / SMTP_PASSWORD, aucun email ne part) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@cem.mg

# --- Optionnel ---
# Traduction automatique FR -> EN
ANTHROPIC_API_KEY=
SENTRY_DSN=
# Redis : USE_REDIS=true + --profile with-redis ; permet alors WEB_CONCURRENCY=2 ou plus
USE_REDIS=false
WEB_CONCURRENCY=1
