# Variables du déploiement Docker (docker-compose.prod.yml).
#   cp .env.production.example .env.production
# Ne commitez jamais .env.production.

# Base de données (mot de passe long et aléatoire)
POSTGRES_USER=cem
POSTGRES_PASSWORD=
POSTGRES_DB=cem

# Clé de signature des sessions (48+ caractères aléatoires). Générez-la avec :
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# L'API refuse de démarrer si elle est absente, trop courte ou égale à une valeur d'exemple.
SECRET_KEY=

# Adresse publique du site (liens dans les emails)
FRONTEND_URL=https://www.exemple.org

# Port HTTP exposé par le conteneur nginx (derrière votre reverse proxy HTTPS)
HTTP_PORT=8080

# Nombre de processus de l'API
WEB_CONCURRENCY=2

# Paiement par carte : "disabled" tant qu'aucun vrai prestataire n'est branché
# ("simulation" est refusé en production). Voir backend/app/services/payments.py.
CARD_PAYMENT_PROVIDER=disabled

# Emails (remerciements, accusés de réception, réinitialisation de mot de passe)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@cem.mg
FROM_NAME=Club Excellence Madagascar

# Suivi des erreurs (optionnel)
SENTRY_DSN=
