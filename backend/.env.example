# Copiez ce fichier en .env :  cp .env.example .env

# Base de données — correspond au service PostgreSQL de docker-compose.yml
DATABASE_URL=postgresql+asyncpg://cem:cem@localhost:5432/cem

# Clé de signature des JWT — générez-en une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=remplacez-moi-par-une-cle-aleatoire

ENVIRONMENT=development

# Redis (optionnel) — sans Redis, un message "Redis connection failed" s'affiche au démarrage, sans conséquence
USE_REDIS=false
# REDIS_URL=redis://localhost:6379/0

# Emails (optionnel) — remerciements aux donateurs, réinitialisation de mot de passe.
# Sans SMTP_USER / SMTP_PASSWORD, aucun email ne part : leur contenu s'affiche dans le terminal du backend.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# FROM_EMAIL=noreply@cem.mg
# FROM_NAME=Club Excellence Madagascar

# Paiement par carte : "simulation" (aucun paiement réel ; automatiquement refusé si ENVIRONMENT=production)
# ou "disabled". Un vrai prestataire (Stripe...) s'ajoute dans app/services/payments.py.
CARD_PAYMENT_PROVIDER=simulation
