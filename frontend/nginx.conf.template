# Sert le build React et relaie l'API vers le backend.
# Modèle : au démarrage, l'image nginx remplace ${PORT}, ${BACKEND_ADDRESS} et ${NGINX_LOCAL_RESOLVERS}
# par les variables d'environnement (valeurs par défaut dans le Dockerfile). Les variables nginx ($host...) restent intactes.

# Robots des réseaux sociaux : ils n'exécutent pas le JavaScript. On leur sert une page d'aperçu
# (titre, résumé, image de l'élément partagé) générée par l'API. Google exécute le JavaScript : absent.
map $http_user_agent $is_share_bot {
    default 0;
    ~*(facebookexternalhit|facebookcatalog|Facebot|LinkedInBot|Twitterbot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|SkypeUriPreview|redditbot|Applebot|Embedly|vkShare) 1;
}
# Journal : IP du visiteur, puis adresse de connexion et X-Forwarded-For reçus (pour vérifier TRUSTED_PROXIES, voir real-ip.sh)
log_format visitor '$remote_addr (via $realip_remote_addr, xff "$http_x_forwarded_for") - [$time_local] '
                   '"$request" $status $body_bytes_sent "$http_user_agent"';
# En production, placez un reverse proxy HTTPS (Caddy, Traefik, nginx + certbot...) devant ce conteneur.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    access_log /var/log/nginx/access.log visitor;

    # Adresse du backend recherchée à chaque requête (cache 10 s) et non une seule fois au démarrage :
    # sur Render, l'IP privée du backend change à chaque redéploiement.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend "http://${BACKEND_ADDRESS}";

    server_tokens off;
    # Politique de sécurité du contenu : seuls les scripts du site s'exécutent (pas de script injecté,
    # pas de script tiers). Origines externes autorisées : polices Google, adresses OpenStreetMap
    # (autocomplétion des villes), images https (carte, photos). Un vrai prestataire de paiement par
    # carte (ex. Stripe) devra être ajouté à script-src, connect-src et frame-src.
    set $csp "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://nominatim.openstreetmap.org; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Taille max des images envoyées (MAX_UPLOAD_SIZE = 5 Mo côté API)
    client_max_body_size 6m;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        # IP réelle du visiteur (rate limit, journal d'audit). $remote_addr : celle de la connexion, ou celle retenue
        # par real-ip.sh derrière un proxy de confiance ; jamais une valeur envoyée telle quelle par le client
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /uploads/ {
        proxy_pass $backend;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public";
        add_header X-Content-Type-Options "nosniff" always;
        # Images envoyées par les utilisateurs : ouvertes seules, elles ne peuvent rien exécuter
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox" always;
    }

    # Référencement : générés à partir du contenu publié
    location = /sitemap.xml {
        proxy_pass $backend/api/v1/seo/sitemap.xml;
        proxy_set_header Host $host;
    }
    location = /robots.txt {
        proxy_pass $backend/api/v1/seo/robots.txt;
        proxy_set_header Host $host;
    }

    location /health {
        proxy_pass $backend/health;
    }

    # Fichiers du build (noms avec empreinte) : cache long
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Application monopage : toute autre URL renvoie index.html (jamais mis en cache)
    location / {
        if ($is_share_bot) {
            rewrite ^ /api/v1/seo/share?path=$uri last;
        }
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy $csp always;
    }
}
